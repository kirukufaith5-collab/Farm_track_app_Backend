# Application
APP_NAME=FarmTrack API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production
API_V1_PREFIX=/api/v1

# Database (PostGIS)
DATABASE_URL=postgresql+psycopg://farmtrack:farmtrack@db:5432/farmtrack

# JWT / Cookies
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_ACCESS_NAME=ft_access
COOKIE_REFRESH_NAME=ft_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CORS (comma-separated origins). Include your Vercel URL.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend URL (for docs / redirects if needed)
FRONTEND_URL=http://localhost:5173
